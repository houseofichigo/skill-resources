{
  "$schema": "schema/brand.config.v2.schema.json",
  "$comment": "The ONLY file you edit by hand. Everything else is generated from it. This starter is in create mode: every value is a placeholder ($src WO, $conf default) for a fictional company. For an existing brand, set mode to reproduce and give every value a $src from `sources` — see references/config-v2.md and examples/house-of-ichigo/brand.config.json.",
  "config_version": 2,
  "mode": "create",
  "brand": "Your Company",
  "slug": "your-company",
  "version": "1.0",
  "date": "Month Year",
  "supersedes": "nothing",
  "owner": {
    "name": null,
    "role": null,
    "$gap": "who signs the brand off"
  },
  "sources": {
    "WO": {
      "kind": "default",
      "title": "website-os default — not the brand"
    }
  },
  "$src": "WO",
  "locales": {
    "default": "en",
    "list": [
      "en"
    ],
    "rtl": [],
    "$note": "Add 'ar' to switch on the RTL layer and the Arabic face; add 'fr' for a copy locale."
  },
  "identity": {
    "positioning": {
      "architecture": null,
      "boundary": "One sentence. What you do, for whom, and the thing you will not do.",
      "$gap_architecture": "one line of structure, if the brand has one"
    }
  },
  "voice": {
    "banned": {
      "list": [
        "leverage",
        "synergy",
        "seamless",
        "unlock",
        "empower",
        "cutting-edge",
        "best-in-class",
        "transformative",
        "journey",
        "game-changing",
        "next-generation",
        "revolutionary"
      ],
      "$comment": "The checker warns on these. Add the words your market has worn out."
    }
  },
  "color": {
    "roles": {
      "bg": {
        "hex": "#FFFFFF",
        "role": "the page. Everything sits on this."
      },
      "fg": {
        "hex": "#111111",
        "role": "all body text, and the dark surface"
      },
      "accent": {
        "hex": "#1231D6",
        "role": "the one brand colour. Every CTA, link, focus ring."
      },
      "accent_on": {
        "hex": "#FFFFFF",
        "role": "text on the brand colour"
      },
      "accent_on_dark": {
        "hex": "#7FA0FF",
        "role": "the brand colour where it must sit on ink"
      },
      "muted": {
        "hex": "#5A6478",
        "role": "secondary text on LIGHT surfaces only"
      },
      "surface": {
        "hex": "#F2F5F8",
        "role": "hover, disabled, quiet fills"
      },
      "border": {
        "hex": "#E3E8EF",
        "role": "hairlines"
      }
    },
    "accents": {
      "$comment": "Wayfinding only — never a button, never body copy. Delete the block if you have none.",
      "one": {
        "hex": "#00707F",
        "label": "First pillar"
      },
      "two": {
        "hex": "#008558",
        "label": "Second pillar"
      },
      "three": {
        "hex": "#E2006D",
        "label": "Third pillar"
      }
    },
    "semantic": {
      "$comment": "Fills that mean 'a human must act'. Keep this list as short as you can defend. A success colour is usually unnecessary: see docs/00-method.md.",
      "attention": {
        "hex": "#FFC411",
        "on": "fg",
        "use": "needs a decision"
      },
      "blocking": {
        "hex": "#E51919",
        "on": "bg",
        "use": "a hard stop"
      }
    },
    "retired": {
      "$comment": "Every hex your previous identity used. The checker fails on these, which is how old material stops leaking into new work.",
      "old_accent": "#CF5B2B",
      "old_ground": "#FAFAF7"
    }
  },
  "avoid_palettes": {
    "$comment": "Palettes yours must not read as. The build measures RGB distance against every one and fails under the threshold. Add your three closest competitors and whichever AI tool your market uses — that is how a brand stops looking generated. See docs/00-method.md.",
    "threshold": 40,
    "sets": {
      "anthropic": [
        "#F0EEE6",
        "#D97757",
        "#191919"
      ],
      "tailwind_default": [
        "#3B82F6",
        "#F59E0B",
        "#DC2626",
        "#0891B2",
        "#10B981"
      ],
      "competitor_a": []
    }
  },
  "type": {
    "families": {
      "display": {
        "family": "Manrope",
        "npm": "@fontsource-variable/manrope",
        "file": "manrope-latin-wght-normal",
        "weights": {
          "axis": [
            200,
            800
          ]
        },
        "base_weight": 600,
        "accent_weight": 800,
        "has_italic": false,
        "use": "display, every heading, and the whole interface"
      },
      "text": {
        "family": "Inter Tight",
        "npm": "@fontsource-variable/inter-tight",
        "file": "inter-tight-latin-wght-normal",
        "italic_file": "inter-tight-latin-wght-italic",
        "weights": {
          "axis": [
            300,
            800
          ]
        },
        "has_italic": true,
        "ceiling_px": 20,
        "use": "long-form body text only, never above the ceiling"
      },
      "mono": {
        "family": "JetBrains Mono",
        "npm": "@fontsource-variable/jetbrains-mono",
        "file": "jetbrains-mono-latin-wght-normal",
        "weights": {
          "axis": [
            300,
            700
          ]
        },
        "use": "labels, metadata, folios, and ALL numerals"
      },
      "arabic": {
        "family": "IBM Plex Sans Arabic",
        "npm": "@fontsource/ibm-plex-sans-arabic",
        "file_pattern": "ibm-plex-sans-arabic-arabic-{w}-normal",
        "weights": {
          "static": [
            400,
            500,
            600,
            700
          ]
        },
        "scale": 0.95,
        "line_height_bump": 0.1
      }
    },
    "tracking": {
      "$comment": "Negative tracking is REQUIRED on most geometric sans at display size and PROHIBITED on most serifs. Check yours by eye at 88px before trusting these.",
      "bands": [
        {
          "min_px": 64,
          "value": "-.035em",
          "family": "display"
        },
        {
          "min_px": 43,
          "value": "-.03em",
          "family": "display"
        },
        {
          "min_px": 24,
          "value": "-.02em",
          "family": "display"
        },
        {
          "min_px": 18,
          "value": "-.01em",
          "family": "display"
        },
        {
          "min_px": 0,
          "value": "0",
          "family": "display"
        },
        {
          "family": "text",
          "min_px": 0,
          "value": "0"
        },
        {
          "family": "mono",
          "min_px": 0,
          "value": "0"
        }
      ]
    },
    "scale": {
      "roles": [
        {
          "role": "display_xl",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 88,
            "tablet": 64,
            "phone": 44
          },
          "lh": 1.02,
          "html": "h1"
        },
        {
          "role": "display_lg",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 64,
            "tablet": 52,
            "phone": 36
          },
          "lh": 1.02,
          "html": "h2"
        },
        {
          "role": "heading_lg",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 36,
            "tablet": 32,
            "phone": 28
          },
          "lh": 1.15,
          "html": "h2"
        },
        {
          "role": "heading_md",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 24,
            "tablet": 24,
            "phone": 22
          },
          "lh": 1.2,
          "html": "h3"
        },
        {
          "role": "heading_sm",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 18,
            "tablet": 18,
            "phone": 18
          },
          "lh": 1.25,
          "html": "h4"
        },
        {
          "role": "body_lg",
          "family": "text",
          "weight": 400,
          "px": {
            "desktop": 18,
            "tablet": 18,
            "phone": 18
          },
          "lh": 1.55
        },
        {
          "role": "body",
          "family": "text",
          "weight": 400,
          "px": {
            "desktop": 16,
            "tablet": 16,
            "phone": 16
          },
          "lh": 1.55,
          "html": "p"
        },
        {
          "role": "caption",
          "family": "text",
          "weight": 400,
          "px": {
            "desktop": 14,
            "tablet": 14,
            "phone": 14
          },
          "lh": 1.45
        },
        {
          "role": "eyebrow",
          "family": "mono",
          "weight": 500,
          "px": {
            "desktop": 12,
            "tablet": 12,
            "phone": 12
          },
          "lh": 1.3,
          "case": "upper",
          "tracking": ".18em"
        },
        {
          "role": "button",
          "family": "display",
          "weight": 600,
          "px": {
            "desktop": 16,
            "tablet": 16,
            "phone": 16
          },
          "lh": 1.4
        },
        {
          "role": "mono",
          "family": "mono",
          "weight": 400,
          "px": {
            "desktop": 14,
            "tablet": 14,
            "phone": 14
          },
          "lh": 1.45
        }
      ]
    }
  },
  "layout": {
    "spacing": {
      "base_px": {
        "value": 4
      },
      "steps": {
        "sp-1": 4,
        "sp-2": 8,
        "sp-3": 12,
        "sp-4": 16,
        "sp-5": 24,
        "sp-6": 32,
        "sp-7": 48,
        "sp-8": 64,
        "sp-9": 96,
        "sp-10": 128
      }
    },
    "breakpoints": {
      "order": [
        "phone",
        "tablet",
        "desktop",
        "wide"
      ],
      "min": {
        "phone": 0,
        "tablet": 640,
        "desktop": 1024,
        "wide": 1280
      },
      "tailwind": {
        "sm": "tablet",
        "lg": "desktop",
        "xl": "wide",
        "md": null,
        "2xl": null
      }
    },
    "grid": {
      "phone": {
        "columns": 4,
        "gutter": 16,
        "margin": 20
      },
      "tablet": {
        "columns": 8,
        "gutter": 20,
        "margin": 32
      },
      "desktop": {
        "columns": 12,
        "gutter": 24,
        "margin": 48,
        "max": 1280
      }
    },
    "containers": {
      "max": 1280,
      "prose_ch": 72
    },
    "section_rhythm": {
      "phone": 64,
      "tablet": 96,
      "desktop": 128
    }
  },
  "density": {
    "$comment": "pad_y is DERIVED so a row is exactly 2*pad + one line box. Set row, text and line_height; the build computes the rest and fails if they disagree.",
    "line_height": 1.4,
    "scales": {
      "comfortable": {
        "row": 48,
        "text": 16,
        "label": 14,
        "pad_x": 16,
        "use": "forms, onboarding, anything met once"
      },
      "compact": {
        "row": 36,
        "text": 14,
        "label": 12,
        "pad_x": 12,
        "use": "the product's working screens"
      },
      "dense": {
        "row": 28,
        "text": 13,
        "label": 11,
        "pad_x": 8,
        "use": "data tables only, 25 rows or more"
      }
    }
  },
  "shape": {
    "surface": 0,
    "control": 2,
    "floating": 4,
    "$comment": "0 holds content, 2 you press, 4 floats. Raise these if your brand is softer, but keep it to three values."
  },
  "elevation": {
    "method": "border",
    "levels": {
      "e0": {
        "name": "ground",
        "surface": "{color.bg}",
        "border": "none",
        "scrim": "none"
      },
      "e1": {
        "name": "raised",
        "surface": "{color.bg}",
        "border": {
          "width": 1,
          "color": "{color.border}",
          "style": "solid"
        },
        "scrim": "none"
      },
      "e2": {
        "name": "overlay",
        "surface": "{color.bg}",
        "border": {
          "width": 1,
          "color": "{color.fg}",
          "style": "solid"
        },
        "scrim": "none"
      },
      "e3": {
        "name": "modal",
        "surface": "{color.bg}",
        "border": {
          "width": 1,
          "color": "{color.fg}",
          "style": "solid"
        },
        "scrim": {
          "color": "{color.fg}",
          "alpha": 0.5
        }
      }
    },
    "shadows": {
      "value": "none"
    }
  },
  "effects": {
    "$comment": "Your brand's prohibitions. check.py enforces exactly these and nothing else. v1 hard-coded no-shadow, no-gradient and a radius cap for every brand; set them to what YOUR brand allows.",
    "policy": {
      "shadow": "none",
      "gradient": "none",
      "blur": "allowed",
      "filter": "allowed",
      "radius_max_px": 4,
      "elevation": "border",
      "transform_on_press": true,
      "decorative_animation": false,
      "opacity_hover": true,
      "font_service_links": "none"
    }
  },
  "motion": {
    "durations_ms": {
      "instant": 0,
      "fast": 120,
      "base": 180,
      "slow": 260,
      "deliberate": 400
    },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "enter": "cubic-bezier(0,0,0,1)",
      "exit": "cubic-bezier(.3,0,1,1)"
    }
  },
  "a11y": {
    "target": "WCAG 2.2 AA",
    "target_min_px": 44,
    "floors": {
      "body_text": 4.5,
      "large_text": 3.0,
      "component_boundary": 3.0
    }
  },
  "book": {
    "page": {
      "width_mm": 297,
      "height_mm": 210,
      "margin_mm": [
        19,
        22,
        15,
        22
      ]
    },
    "sections": [
      "00 · Foundation",
      "01 · Logo",
      "02 · Colour",
      "03 · Typography",
      "04 · Voice",
      "05 · Composition",
      "06 · Applications",
      "07 · Governance",
      "08 · Interface",
      "09 · Experience"
    ],
    "status": "starter",
    "$status_note": "starter · draft · final. The divergence check measures how many of the shipped chassis's own sentences are still in your book. 'starter' reports, 'draft' warns, 'final' FAILS over 25% — set it to 'final' before handover so a recoloured chassis cannot go out as a brand book. See docs/05-contents.md."
  },
  "reconcile": {
    "items": []
  }
}
